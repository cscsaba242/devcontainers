{
  "name": "helmtest2",
  "remoteUser": "root",
   "build": {
    "dockerfile": "Dockerfile",
      "args": {
      "HTTP_PROXY": "http://tudas-proxy.rd.hu.t-internal.com:3128",
      "HTTPS_PROXY": "http://tudas-proxy.rd.hu.t-internal.com:3128",
      "NO_PROXY": ""
    }
  },
  "postCreateCommand": "bash ./.devcontainer/helmtest2/postCreateCommand.sh",

  "mounts": [
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
  ],

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker",
        "ms-kubernetes-tools.vscode-kubernetes-tools"
      ]
    }
  }
}
